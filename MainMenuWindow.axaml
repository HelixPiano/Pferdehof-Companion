<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="PferdehofGUI.MainMenuWindow"
        WindowStartupLocation="CenterOwner"
        Title="PferdehofGUI"
        Width="400" Height="380"
        Opened="OnWindowOpened">
    <ScrollViewer>
        <StackPanel Margin="20" Spacing="12">
            <TextBlock x:Name="PlayerLabel" FontWeight="Bold" FontSize="16"/>
            <Separator/>
            <Button Content="1. Edit Horse" HorizontalAlignment="Stretch" Padding="10" Click="OnEditHorseClick"/>
            <TextBlock Text="Make sure Pferdehof is fully closed before editing horses." FontSize="11" Opacity="0.7" TextWrapping="Wrap" Margin="0,-6,0,0"/>
            <Button Content="2. Breeder Support" HorizontalAlignment="Stretch" Padding="10" Click="OnBreederSupportClick"/>
            <Button Content="3. Foal Checker" HorizontalAlignment="Stretch" Padding="10" Click="OnFoalCheckerClick"/>
            <Button Content="4. My Horses - Overview" HorizontalAlignment="Stretch" Padding="10" Click="OnHorseOverviewClick"/>
            <Separator Margin="0,10,0,10"/>
            <Button Content="Switch Player" HorizontalAlignment="Left" Click="OnSwitchPlayerClick"/>
            <Button Content="Repair Horse List..." HorizontalAlignment="Left" Click="OnRepairClick"/>
        </StackPanel>
    </ScrollViewer>
</Window>
