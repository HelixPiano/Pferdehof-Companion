<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="PferdehofGUI.FoalCheckerView">
    <DockPanel Margin="15">
        <Button DockPanel.Dock="Top" Content="Refresh" Click="OnRefreshClick" Margin="0,0,0,10" HorizontalAlignment="Left"/>
        <Grid ColumnDefinitions="200,*">
            <ListBox Grid.Column="0" x:Name="FoalListBox" SelectionChanged="OnFoalSelected"/>
            <ScrollViewer Grid.Column="1" Margin="10,0,0,0">
                <TextBlock x:Name="ReportText" TextWrapping="Wrap" FontFamily="Consolas,monospace"/>
            </ScrollViewer>
        </Grid>
    </DockPanel>
</UserControl>
