<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="PferdehofGUI.HorseListView">
    <DockPanel Margin="15">
        <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Spacing="8" Margin="0,0,0,10">
            <TextBlock Text="Filter:" VerticalAlignment="Center"/>
            <RadioButton Content="All" GroupName="filter" x:Name="FilterAll" IsChecked="True" Click="OnFilterChanged"/>
            <RadioButton Content="Mine" GroupName="filter" x:Name="FilterMine" Click="OnFilterChanged"/>
            <RadioButton Content="Breeder" GroupName="filter" x:Name="FilterBreeder" Click="OnFilterChanged"/>
            <RadioButton Content="Offline" GroupName="filter" x:Name="FilterOffline" Click="OnFilterChanged"/>
            <Button Content="Refresh" Click="OnRefreshClick" Margin="20,0,0,0"/>
        </StackPanel>

        <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" Spacing="10" Margin="0,10,0,0">
            <Button Content="Edit Selected Horse" Click="OnEditClick"/>
            <TextBlock x:Name="StatusText" VerticalAlignment="Center" Foreground="Red"/>
        </StackPanel>

        <ListBox x:Name="HorseListBox" DoubleTapped="OnHorseDoubleTapped"/>
    </DockPanel>
</UserControl>
